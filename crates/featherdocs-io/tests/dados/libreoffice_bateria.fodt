<office:body><office:text>
<text:h text:style-name="Heading_20_1" text:outline-level="1">Título Um</text:h>
<text:p text:style-name="Standard">Texto com <text:span text:style-name="T1">negrito vermelho</text:span> e <text:span text:style-name="T2">itálico sublinhado</text:span>.<text:note text:id="ftn1" text:note-class="footnote"><text:note-citation>1</text:note-citation><text:note-body><text:p>Nota ZQN1 de rodapé.</text:p></text:note-body></text:note> Fim<text:note text:id="edn1" text:note-class="endnote"><text:note-citation>i</text:note-citation><text:note-body><text:p>Nota ZQE1 de fim.</text:p></text:note-body></text:note>.</text:p>
<text:h text:style-name="Heading_20_2" text:outline-level="2">Listas</text:h>
<text:list text:style-name="Num">
 <text:list-item><text:p>Primeiro</text:p>
  <text:list><text:list-item><text:p>Sub a</text:p></text:list-item><text:list-item><text:p>Sub b</text:p></text:list-item></text:list>
 </text:list-item>
 <text:list-item><text:p>Segundo</text:p></text:list-item>
</text:list>
<text:list text:style-name="Bul"><text:list-item><text:p>Bala um</text:p></text:list-item><text:list-item><text:p>Bala dois</text:p></text:list-item></text:list>
<text:h text:style-name="Heading_20_2" text:outline-level="2">Tabela</text:h>
