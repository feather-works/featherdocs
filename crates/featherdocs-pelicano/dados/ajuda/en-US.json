    "introducoes": {
      "uso": "FeatherDocs is a document editor that runs entirely on your machine: no account, no login, none of your text leaves it. Here is how to use each part, from typing and formatting to tables, page setup and files. Follow in order with the arrow, or pick a topic in the side menu.",
      "atalhos": "The keys that get things done faster. All of them work with the cursor in the text; the file ones work anywhere in the window."
    },
    "comoUsar": {
      "comecar": {
        "titulo": "Getting started",
        "corpo": [
          "Click the page and type: text appears where the cursor blinks. Enter starts a new paragraph; Backspace joins it to the previous one.",
          "• Drag the mouse (or use Shift + arrows) to select, even across paragraphs.",
          "• Double-click selects the word; triple-click, the paragraph.",
          "• Ctrl+Z undoes and Ctrl+Y redoes.",
          "Commands are in the ribbon at the top and in the menus (File, Edit, View…). Double-clicking a ribbon tab minimizes it.",
          "The Home button in the corner goes back to the start page; the document stays open and you return with \"Back to the document\"."
        ]
      },
      "formatar": {
        "titulo": "Formatting text",
        "corpo": [
          "Select the text and use the ribbon (Home → Font) or the keyboard. With no selection, the formatting applies to what you type next.",
          "• Bold Ctrl+B, italic Ctrl+I, underline Ctrl+U, code Ctrl+E, strikethrough Ctrl+Shift+X.",
          "• Repeating the command on an already formatted selection removes the formatting.",
          "Tip: typing # and a space at the start of a line makes a heading (## is level 2, and so on); \"- \" makes a list, \"1. \" a numbered list, \"> \" a quote, \"---\" a horizontal line."
        ]
      },
      "estrutura": {
        "titulo": "Headings, lists and contents",
        "corpo": [
          "The paragraph style is under Home → Styles (Normal, Heading 1 to 3, and more under the ▾ button) or Format → Paragraph styles. Ctrl+Alt+0 to 6 also switch it: 0 is normal text, 1 to 6 are headings.",
          "• Bulleted list: Ctrl+Shift+8. Numbered list: Ctrl+Shift+7. Repeating the style undoes the list.",
          "• Tab goes one level down in a list and Shift+Tab goes up.",
          "• Insert → Table of contents adds an index that FeatherDocs keeps up to date with the headings.",
          "The Outline button (View) opens a panel with the document's headings; clicking one jumps there."
        ]
      },
      "tabelas": {
        "titulo": "Tables",
        "corpo": [
          "Insert → Table creates a table with the cursor in the first cell. Tab moves to the next cell and, in the last one, adds a row.",
          "In the installed app, with the cursor in a table the Table tab shows \"Edit in FeatherSheet\": the table opens as a spreadsheet and, when you save there, comes back updated into the document. This is not available in the browser version."
        ]
      },
      "pagina": {
        "titulo": "Paper, margins and breaks",
        "corpo": [
          "Layout → Paper switches between A4 and Letter; Layout → Margins offers Normal (2.54 cm), Narrow (1.27 cm), Moderate, Wide and ABNT.",
          "Layout → Breaks inserts page, column, text wrapping (Shift+Enter) and section breaks (next page, continuous, even page and odd page).",
          "FeatherDocs refuses a margin that leaves less than 100 pt (about 3.5 cm) of width for the text.",
          "View → Zoom (or Ctrl + mouse wheel) changes the size of the page on screen without changing the document."
        ]
      },
      "arquivos": {
        "titulo": "Files and export",
        "corpo": [
          "FeatherDocs' own format is .fdoz. It also opens Markdown (.md), LaTeX (.tex) and Word (.docx).",
          "• File → Save (Ctrl+S) and Save as (Ctrl+Shift+S) write .fdoz. In the browser, the file is downloaded.",
          "• File → Export writes Markdown or LaTeX.",
          "• The window title shows a dot (•) when there are unsaved changes; the footer says \"Saved\" or \"Not saved\".",
          "Everything stays on your computer: FeatherDocs has no account, cloud or telemetry."
        ]
      },
      "configuracoes": {
        "titulo": "Settings",
        "corpo": [
          "The gear (at the top of the window) opens Settings: theme (automatic, light or dark), accent color and language.",
          "Theme, color and language apply right away."
        ]
      }
    },
